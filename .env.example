# Supabase project (Project Settings -> API in the Supabase dashboard).
# The publishable/anon key is safe to expose to the browser — it is
# authorized only through Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Symmetric key used to encrypt each user's Gemini API key at rest
# (AES-256-GCM). Generate with: openssl rand -base64 32
# Never reuse this across environments; rotating it invalidates every
# already-saved Gemini key (users would need to re-enter theirs).
GEMINI_KEY_ENCRYPTION_SECRET=
