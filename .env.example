# Host development. For production set APP_URL to your public HTTPS origin.
APP_URL=http://localhost:3100
WEB_PORT=3100

POSTGRES_USER=resume
# Set a unique URL-safe password for production (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume
POSTGRES_PORT=55432
# Host tools use this address. Compose builds its internal URL from the fields above.
DATABASE_URL=postgres://resume:resume@localhost:55432/resume

REDIS_PORT=16379
REDIS_URL=redis://localhost:16379

S3_PORT=14566
S3_ENDPOINT=http://localhost:14566
S3_PUBLIC_ENDPOINT=http://localhost:14566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Required. Generate with openssl rand -base64 32 and preserve across deploys.
KEY_ENCRYPTION_SECRET=
ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=
LOG_LEVEL=info

# Optional Gemini model override, proxy, and opt-in live smoke test key.
GEMINI_MODEL=
GEMINI_API_BASE_URL=
GEMINI_API_KEY=

# Optional test ports and fake Gemini latency.
E2E_PORT=3217
FAKE_GEMINI_PORT=4010
FAKE_GEMINI_DELAY_MS=0
